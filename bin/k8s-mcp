#!/bin/zsh

set -o pipefail
umask 077

environment_name=${1:-}
case "$environment_name" in
  dev|staging) ;;
  *)
    print -u2 "Usage: k8s-mcp {dev|staging}"
    exit 2
    ;;
esac

binary="${KUBERNETES_MCP_SERVER_BIN:-$HOME/.local/bin/kubernetes-mcp-server}"
kubeconfig="$HOME/.kube/mcp-$environment_name.yaml"
config="${DOTFILES:-$HOME/.dotfiles}/kubernetes/mcp-readonly.toml"
state_dir="$HOME/.local/state/k8s-mcp/clients"
log_dir="$HOME/Library/Logs/k8s-mcp"
record="$state_dir/$environment_name.$$.tsv"

if [[ ! -x "$binary" ]]; then
  print -u2 "Kubernetes MCP server is not installed at $binary"
  exit 1
fi

if [[ ! -r "$kubeconfig" ]]; then
  print -u2 "Missing kubeconfig: $kubeconfig"
  exit 1
fi

mkdir -p "$state_dir" "$log_dir"
chmod 700 "$HOME/.local/state/k8s-mcp" "$state_dir"

# The cluster-specific proxy lives in kubeconfig. Ambient proxy variables would
# incorrectly route MCP and authentication traffic through the bastion.
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy

if ! gke-tunnel ensure "$environment_name" >&2; then
  print -u2 "Unable to establish the $environment_name cluster tunnel"
  exit 1
fi

cleanup() {
  rm -f "$record"
}
trap cleanup EXIT HUP INT TERM

printf '%s\t%s\t%s\t%s\n' \
  "$environment_name" "$$" "$PPID" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >|"$record"

"$binary" \
  --config "$config" \
  --kubeconfig "$kubeconfig" \
  --cluster-provider kubeconfig \
  --disable-multi-cluster \
  --read-only \
  --log-file "$log_dir/$environment_name.log"
