{
  "$schema": "https://opencode.ai/config.json",
  "theme": "vesper",
  "permission": {
    "bash": {
      "docker system prune": "ask",
      "git clean": "ask",
      "git push": "ask",
      "git reset --hard": "ask",
      "kubectl delete": "ask",
      "rm -rf": "ask",
      "terraform apply": "ask",
      "terraform destroy": "ask",
    },
    "doom_loop": "ask",
  },
  "plugin": ["opencode-anthropic-auth@0.0.13"],
}
